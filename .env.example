# ---------------------------------------------------------------
# APA — required environment variables.
# Copy to .env.local and fill in. .env.local is git-ignored.
# ---------------------------------------------------------------

# Supabase — Project Settings → API. Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key. Safe in the browser. Signs admins in.
# Newer Supabase projects call this the publishable key; either name works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service_role key. SERVER ONLY — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# The live site. Used for email links and redirects.
# Currently the Vercel URL; swap to https://www.apahelpdesk.com.au once
# that domain is registered and pointed at Vercel.
NEXT_PUBLIC_SITE_URL=

# Master switch for outbound email. Nothing is sent unless this is exactly
# "true". Leave it off until the Resend sending domain shows Verified.
# EMAIL_ENABLED=true

# Resend — resend.com → API Keys. Wired in Build 2. SERVER ONLY.
# RESEND_API_KEY=
# Address the confirmation email is sent from. Wired in Build 2.
# RESEND_FROM_EMAIL=
# Either name works; RESEND_FROM_EMAIL wins if both are set.
# RESEND_FROM=
# Where the internal new-enquiry notification goes.
# RESEND_NOTIFY_TO=
